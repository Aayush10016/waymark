      "categories": ["schemes"],
      "input": {
        "url": "https://docs.spring.io/spring-security/reference/servlet/integrations/cors.html#configuration",
        "title": "CORS :: Spring Security"
      },
      "expected": {
        "decision": "allow",
        "canonicalUrl": "https://docs.spring.io/spring-security/reference/servlet/integrations/cors.html",
        "hostname": "docs.spring.io",
        "searchQuery": null,
        "removedQueryParameters": [],
        "policyVersion": "url-query-sanitation-v1"
      }
    },
    {
      "id": "scheme-http-allowed",
      "categories": ["schemes"],
      "input": {
        "url": "http://example.test/docs/cors?utm_source=newsletter",
