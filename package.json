{
  "name": "trail",
  "version": "0.1.0",
  "private": true,
  "description": "Trail engineering memory monorepo.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "ci:dependencies": "node scripts/ci/check-dependencies.mjs",
    "ci:format": "node scripts/ci/check-format.mjs",
    "ci:secrets": "node scripts/ci/scan-secrets.mjs",
    "ci:sanitation-fixtures": "node scripts/ci/check-url-query-sanitation-fixtures.mjs",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "openapi:check": "node scripts/ci/check-openapi-client.mjs",
    "openapi:generate": "pnpm --filter @trail/api-client generate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm ci:format && pnpm ci:secrets && pnpm ci:sanitation-fixtures && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@redocly/cli": "2.38.0",
    "@trail/eslint-config": "workspace:*",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.4",
    "globals": "17.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
