{
  "manifest_version": 3,
  "name": "Trail",
  "description": "Never solve the same engineering problem twice.",
  "version": "0.1.0",
  "minimum_chrome_version": "149",
  "action": {
    "default_title": "Trail",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  },
  "commands": {
    "trail-recall": {
      "description": "Recall a similar solved Trail problem.",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "alarms",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ]
}
