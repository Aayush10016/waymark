# Trail Render staging environment contract.
# Values shown here are placeholders only. Configure real values in Render.

PORT=8080
TRAIL_DATABASE_URL=[render-internal-postgres-jdbc-url]
TRAIL_DATABASE_USERNAME=[render-database-user]
TRAIL_DATABASE_PASSWORD=[render-secret]
TRAIL_JWT_KEY_ID=staging-rs256-001
TRAIL_JWT_ISSUER=trail-staging
TRAIL_JWT_AUDIENCE=trail-extension
TRAIL_JWT_PUBLIC_KEY_PEM=[public-key-only]
TRAIL_IDENTITY_EMAIL_PROVIDER=brevo
TRAIL_IDENTITY_EMAIL_FROM_ADDRESS=[verified-sender-address]
TRAIL_IDENTITY_EMAIL_FROM_NAME=Trail
TRAIL_IDENTITY_EMAIL_BREVO_API_KEY=[render-secret]
TRAIL_IDENTITY_EMAIL_BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email
TRAIL_IDENTITY_EMAIL_TIMEOUT=10s
TRAIL_IDENTITY_VERIFICATION_DESTINATION=https://[staging-app-host]/verify-email
TRAIL_IDENTITY_PASSWORD_RESET_DESTINATION=https://[staging-app-host]/reset-password
TRAIL_AI_PROVIDER=mock
TRAIL_EMBEDDING_PROVIDER=mock
TRAIL_BACKGROUND_JOBS_SCHEDULER_ENABLED=true
